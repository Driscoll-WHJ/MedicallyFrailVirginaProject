{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MES-EDWS",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/MES-EDWS/MES-EDWS/bin/Debug/net10.0/MES-EDWS.dll",
      "args": [],
      "cwd": "${workspaceFolder}/MES-EDWS/MES-EDWS",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
