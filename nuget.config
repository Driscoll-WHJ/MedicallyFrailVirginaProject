<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--
      Restore NuGet packages into a folder inside the repo instead of the
      machine-wide %USERPROFILE%\.nuget\packages cache. This lets the whole
      project (code + packages) be copied to an offline server: restore/build
      there finds every package already extracted in offline-packages and
      never needs to contact nuget.org.
      Path is relative to this nuget.config file.
    -->
    <add key="globalPackagesFolder" value="offline-packages" />
  </config>
  <packageSources>
    <clear />
    <!-- Only used on internet-connected machines to populate offline-packages. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
