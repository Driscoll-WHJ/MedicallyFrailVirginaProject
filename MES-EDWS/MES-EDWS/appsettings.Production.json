{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "MES_EDWS": "Information",
      "MES-EDWS": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Teradata": {
    "Schema": "HR1_DMAS"
  },
  "Deployment": {
    "BaseUrl": "https://vaedws.optum.com"
  },
  // Production uses its own Teradata login (HR1_APIPROD_USR), never the shared Dev/SIT/UAT one
  // from appsettings.json. Blanked here so startup fails unless the real value is supplied by the
  // git-ignored appsettings.Production.secrets.json or ConnectionStrings__TeradataConnection.
  "ConnectionStrings": {
    "TeradataConnection": ""
  },
  "CertificateAuthentication": {
    "AllowSelfSigned": false,
    "RevocationMode": "Online"
  }
}
