{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "MES_EDWS": "Information",
      "MES-EDWS": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Teradata": {
    "Schema": "HR1_DMAS"
  },
  "Deployment": {
    "BaseUrl": "https://vaedws.optum.com"
  },
  // Production must use its own Teradata credentials. Prefer supplying this via an environment
  // variable (ConnectionStrings__TeradataConnection) or a secret store rather than committing it.
  // "ConnectionStrings": {
  //   "TeradataConnection": "Data Source=<PROD_HOST>;User Id=<PROD_USER>;Password=<PROD_PASSWORD>;Connection Timeout=60"
  // },
  "CertificateAuthentication": {
    "AllowSelfSigned": false,
    "RevocationMode": "Online"
  }
}
