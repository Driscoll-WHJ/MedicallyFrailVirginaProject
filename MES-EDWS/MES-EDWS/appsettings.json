{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TeradataConnection": "Data Source=your-teradata-host;User Id=your-username;Password=your-password;",
    "AuditSqlite": "Data Source=audit.db"
  },
  "CertificateAuthentication": {
    "CertificateHeader": "X-Client-Cert",
    "SubjectDNHeader": "X-Client-Subject-DN",
    "AllowSelfSigned": false,
    "RevocationMode": "Online"
  }
}
