<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting template for MES-EDWS.

  This file is transformed by the Web SDK during publish:
    - %LAUNCHER_PATH% / %LAUNCHER_ARGS% are replaced with the real process path/arguments.
    - When a publish profile (Properties/PublishProfiles/*.pubxml) sets <EnvironmentName>,
      the SDK adds <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="..."/> under
      <aspNetCore>. That is what selects appsettings.{Environment}.json and the Teradata schema.

  Do NOT hardcode ASPNETCORE_ENVIRONMENT here; the same code is published to Dev, SIT, UAT
  and Production. Use the matching publish profile instead:
      dotnet publish -c Release -p:PublishProfile=SIT
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- ASPNETCORE_ENVIRONMENT is injected here at publish time from the selected profile. -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
