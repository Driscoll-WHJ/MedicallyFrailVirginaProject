<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MES_EDWS</RootNamespace>
    <!-- This project does not use Swagger/OpenAPI (no AddOpenApi/AddSwaggerGen calls), so
         the Web SDK's implicit OpenAPI document-generation build step isn't needed. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Teradata.Client.Provider" Version="20.0.9" />
  </ItemGroup>

</Project>
